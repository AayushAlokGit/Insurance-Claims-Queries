# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

# Which provider the LLM extractors use. `google` (default) or `openai`.
LLM_PROVIDER=google

# --- Google (Gemini) ---
# Free tier on gemini-2.0-flash is plenty for dev iteration on
# this corpus. Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# gemini-2.5-flash-lite verified on free tier as of 2026-05-23.
# Some keys see limit=0 quota on gemini-2.0-flash — switch model if so.
GOOGLE_MODEL=gemini-2.5-flash-lite

# --- OpenAI ---
# Decrypt the blob at the end of docs/Exercise.md (AES-256-CBC,
# password "adaptional") and paste the resulting key here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
