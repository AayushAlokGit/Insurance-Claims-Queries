# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

# OpenAI API key for the extractor LLM calls.
# Decrypt the blob at the end of Exercise.md (AES-256-CBC, password "adaptional")
# and paste the resulting key here.
OPENAI_API_KEY=

# Model used by all LLM extractors. Pin to a version that supports
# strict structured outputs (response_format with json_schema + strict=true).
OPENAI_MODEL=gpt-4o-2024-08-06
